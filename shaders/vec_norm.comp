#version 450
// norm[0] = ||v|| (L2), computed in a single invocation; zero vector -> 0.
// Dispatch groups: (1,1,1).
layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer BufV { float v[]; };
layout(std430, binding = 1) writeonly buffer BufNorm { float norm[]; };
layout(std430, binding = 2) readonly buffer Params { int n; };

void main() {
    if (n <= 0) { norm[0] = 0.0; return; }
    float s = 0.0;
    for (int i = 0; i < n; ++i) s += v[i] * v[i];
    norm[0] = sqrt(s);
}
