#version 450
// out = (norm[0] == 0) ? 0 : v / norm[0]  (elementwise, n elements).
// Phase 2 of vector_normalize. Dispatch: ceil(n/64) in x.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BufV { float v[]; };
layout(std430, binding = 1) readonly buffer BufNorm { float norm[]; };
layout(std430, binding = 2) writeonly buffer BufOut { float o[]; };
layout(std430, binding = 3) readonly buffer Params { int n; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(n)) return;
    float d = norm[0];
    o[i] = (d == 0.0) ? 0.0 : v[i] / d;
}
