#version 450
// out = scalar * v (elementwise, n elements). Dispatch: ceil(n/64) in x.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BufV { float v[]; };
layout(std430, binding = 1) writeonly buffer BufOut { float o[]; };
layout(std430, binding = 2) readonly buffer ParamsN { int n; };
layout(std430, binding = 3) readonly buffer ParamsS { float scalar; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(n)) return;
    o[i] = scalar * v[i];
}
