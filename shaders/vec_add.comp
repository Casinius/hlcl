#version 450
// out = v1 + v2 (elementwise, n elements). Dispatch: ceil(n/64) in x.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BufV1 { float v1[]; };
layout(std430, binding = 1) readonly buffer BufV2 { float v2[]; };
layout(std430, binding = 2) writeonly buffer BufOut { float o[]; };
layout(std430, binding = 3) readonly buffer Params { int n; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(n)) return;
    o[i] = v1[i] + v2[i];
}
