#version 450
// out = a - b (elementwise, n elements); safe for in-place aliasing
// (out aliases a). Dispatch: ceil(n/64) in x.
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BufA { float a[]; };
layout(std430, binding = 1) readonly buffer BufB { float b[]; };
layout(std430, binding = 2) writeonly buffer BufOut { float o[]; };
layout(std430, binding = 3) readonly buffer Params { int n; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(n)) return;
    o[i] = a[i] - b[i];
}
